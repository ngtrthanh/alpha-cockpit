# Required: generate with: openssl rand -hex 32
HERMES_API_KEY=

# Hermes provider routes. Configure matching credentials inside hermes-data first.
CODEX_PROVIDER=openai-codex
CODEX_MODEL=
CLAUDE_PROVIDER=anthropic
CLAUDE_MODEL=

# SSI FastConnect V3 market-data credentials. No OTP/private key is used.
SSI_CLIENT_ID=
SSI_API_KEY=
SSI_API_SECRET=

# Runtime
PAPER_ENABLED=true
AGENT_INTERVAL_SECONDS=21600
PAPER_INTERVAL_SECONDS=5
ALLOW_DEMO_DATA=false
