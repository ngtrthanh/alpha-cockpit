# Required: generate with: openssl rand -hex 32
HERMES_API_KEY=

# Hermes provider routes. Configure matching credentials inside hermes-data first.
CODEX_PROVIDER=openai-codex
CODEX_MODEL=
CLAUDE_PROVIDER=anthropic
CLAUDE_MODEL=

# Market data is intentionally disabled until another provider is selected.
MARKET_DATA_PROVIDER=none

# Paper trading requires a real market-data provider.
PAPER_ENABLED=false
AGENT_INTERVAL_SECONDS=21600
PAPER_INTERVAL_SECONDS=5
